% Gemini theme
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

% Colors from https://haskayne.ucalgary.ca/brand/standards/colours
\definecolor{ucalgaryred}{RGB}{214, 0, 28}  % #D6001C
\definecolor{ucalgarygold}{RGB}{255, 205, 0}  % #FFCD00
\definecolor{ucalgarydarkgray}{RGB}{37, 40, 42}  % #25282A
\definecolor{ucalgarygray}{RGB}{109, 110, 113}  % #6D6E71
\definecolor{ucalgarylightgray}{RGB}{199, 200, 202}  % #C7C8CA
\definecolor{ucalgarysoftgold}{RGB}{255, 246, 204}
\definecolor{ucalgarysoftred}{RGB}{255, 231, 234}
\definecolor{ucalgarywhite}{RGB}{255, 255, 255}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=ucalgarydarkgray,bg=ucalgarywhite}
\setbeamercolor{palette secondary}{fg=ucalgarydarkgray,bg=ucalgarywhite}
\setbeamercolor{palette tertiary}{bg=ucalgaryred,fg=ucalgarywhite}
\setbeamercolor{palette quaternary}{fg=ucalgarydarkgray,bg=ucalgarywhite}
\setbeamercolor{structure}{fg=ucalgaryred}

% Headline
\setbeamercolor{headline}{fg=ucalgarywhite,bg=ucalgaryred}
\setbeamercolor{headline rule}{bg=ucalgarygold}

% Block
\setbeamercolor{block title}{fg=ucalgaryred,bg=ucalgarywhite}
\setbeamercolor{block separator}{bg=ucalgarygold}
\setbeamercolor{block body}{fg=ucalgarydarkgray,bg=ucalgarywhite}

% Alert Block
\setbeamercolor{block title alerted}{fg=ucalgarydarkgray,bg=ucalgarygold}
\setbeamercolor{block separator alerted}{bg=ucalgaryred}
\setbeamercolor{block body alerted}{fg=ucalgarydarkgray,bg=ucalgarysoftgold}

% Example Block
\setbeamercolor{block title example}{fg=ucalgaryred,bg=ucalgarysoftred}
\setbeamercolor{block separator example}{bg=ucalgarygold}
\setbeamercolor{block body example}{fg=ucalgarydarkgray,bg=ucalgarysoftred}

% Heading
\setbeamercolor{heading}{fg=ucalgarydarkgray}
\setbeamercolor{caption name}{fg=ucalgaryred}

% Itemize
\setbeamercolor{item}{fg=ucalgaryred}

% Bibliography
\setbeamercolor{bibliography item}{fg=ucalgarydarkgray}
\setbeamercolor{bibliography entry author}{fg=ucalgarydarkgray}
\setbeamercolor{bibliography entry title}{fg=ucalgaryred}
\setbeamercolor{bibliography entry location}{fg=ucalgarydarkgray}
\setbeamercolor{bibliography entry note}{fg=ucalgarygray}

% Footline
\setbeamercolor{footline}{fg=ucalgarywhite,bg=ucalgaryred}
